---
source: tests/dot_export.rs
expression: dot
---
digraph "state_machine" {
  rankdir=TB;
  node [fontname="Courier", fontsize=10];
  edge [fontname="Courier", fontsize=9];

  subgraph cluster_resources {
    label="Resources";
    style=dashed;
    color=gray;

    res_mtx [label="mtx\n(Mutex)", shape=hexagon, style=filled, fillcolor="#ffe0e0"];
    res_cv [label="cv\n(Condvar)", shape=triangle, style=filled, fillcolor="#f0e0ff"];
    res_state [label="state\n(Var)", shape=rect, style=filled, fillcolor="#f0f0f0"];

    res_state -> res_mtx [style=dotted, dir=both, color=gray50];
  }

  subgraph cluster_main {
    label="main (normal)";
    style=rounded;
    color=black;

    main_s1 [label="s1: spawn(controller)", shape=doubleoctagon, style="filled", fillcolor="#f0f0f0", color=black, penwidth=3];
    main_s2 [label="s2: spawn(worker)", shape=doubleoctagon, style="filled", fillcolor="#f0f0f0", color=black, penwidth=1];
    main_s3 [label="s3: join(controller)", shape=doubleoctagon, style="filled,dashed", fillcolor="#f0f0f0", color=black, penwidth=1];
    main_s4 [label="s4: join(worker)", shape=doubleoctagon, style="filled,dashed", fillcolor="#f0f0f0", color=black, penwidth=1];
    main_s5 [label="s5: return", shape=ellipse, style="filled", fillcolor="#a0a0a0", color=black, penwidth=1];
    main_ret [label="[ret]", shape=ellipse, style=filled, fillcolor="#a0a0a0"];

    main_s1 -> main_s2;
    main_s2 -> main_s3;
    main_s3 -> main_s4;
    main_s4 -> main_s5;
    main_s5 -> main_ret;
  }

  subgraph cluster_controller {
    label="controller (closure)";
    style=rounded;
    color=black;

    controller_s10 [label="s10: lock(mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=red, penwidth=3];
    controller_s11 [label="s11: write(state, Running)", shape=rect, style="filled", fillcolor="#f0f0f0", color=orange, penwidth=2];
    controller_s12 [label="s12: notify_all(cv)", shape=rect, style="filled,dashed", fillcolor="#f0f0f0", color=purple, penwidth=2];
    controller_s13 [label="s13: drop(mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=green, penwidth=2];
    controller_s14 [label="s14: return", shape=ellipse, style="filled", fillcolor="#a0a0a0", color=black, penwidth=1];
    controller_ret [label="[ret]", shape=ellipse, style=filled, fillcolor="#a0a0a0"];

    controller_s10 -> controller_s11;
    controller_s11 -> controller_s12;
    controller_s12 -> controller_s13;
    controller_s13 -> controller_s14;
    controller_s14 -> controller_ret;
  }

  subgraph cluster_worker {
    label="worker (closure)";
    style=rounded;
    color=black;

    worker_s20 [label="s20: lock(mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=red, penwidth=3];
    worker_s21 [label="s21: read(state)", shape=diamond, style="filled", fillcolor="#ffe8cc", color=black, penwidth=1];
    worker_s22 [label="s22: wait(cv, mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=purple, penwidth=2];
    worker_s23 [label="s23: drop(mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=green, penwidth=2];
    worker_s24 [label="s24: wait(cv, mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=purple, penwidth=2];
    worker_s25 [label="s25: drop(mtx)", shape=rect, style="filled", fillcolor="#f0f0f0", color=green, penwidth=2];
    worker_s26 [label="s26: return", shape=ellipse, style="filled", fillcolor="#a0a0a0", color=black, penwidth=1];
    worker_ret [label="[ret]", shape=ellipse, style=filled, fillcolor="#a0a0a0"];

    worker_s20 -> worker_s21;
    worker_s21 -> worker_s22 [label="Init"];
    worker_s21 -> worker_s24 [label="Paused"];
    worker_s21 -> worker_s23 [label="Running"];
    worker_s21 -> worker_s25 [label="Stopped"];
    worker_s22 -> worker_s21 [color=blue, penwidth=2];
    worker_s23 -> worker_s26;
    worker_s24 -> worker_s21 [color=blue, penwidth=2];
    worker_s25 -> worker_s26;
    worker_s26 -> worker_ret;
  }

  // Cross-function edges
  main_s1 -> controller_s10 [style=dashed, color=blue, label="spawn"];
  main_s2 -> worker_s20 [style=dashed, color=blue, label="spawn"];
  controller_ret -> main_s3 [style=dashed, color=purple, label="join"];
  worker_ret -> main_s4 [style=dashed, color=purple, label="join"];

}
