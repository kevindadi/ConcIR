{
  "program": "lock_order_04",
  "version": "3.5.0",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "src",
          "dst",
          "total"
        ],
        "functions": [
          "main",
          "left",
          "right"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "src",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "dst",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "total",
          "kind": "var",
          "type": "Var",
          "base": {
            "Int": [
              0,
              4
            ]
          },
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "total",
          "lock": "src"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "left",
                "right"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "left",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "src"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "dst"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "total",
              "expr": "total + 2"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "dst"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "src"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "right",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "src"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "dst"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "total",
              "expr": "total + 2"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "dst"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "src"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ],
  "entry": "main::main"
}
