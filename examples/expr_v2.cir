# CIR v0.2 — testing new expression features
program expr_test {
    resources {
        sync mtx : Mutex(Sync);
        var x : Var<Int> = 0;
        var y : Var<Int> = 10;
        var flag : Atomic<Bool> = false;
    }

    protection {
        x -> mtx;
        y -> mtx;
    }

    fn normal main {
        # lock, compute, branch on expression
        s0: res_op(mtx, lock) => next(s1);
        s1: res_op(x, read) => next(s2);
        s2: res_op(x, write((x + y) * 2)) => next(s3);
        s3: res_op(y, write(y - 1)) => branch(y > 0, s4, s5);
        s4: res_op(mtx, drop) => next(s0);   # loop back
        s5: res_op(mtx, drop) => next(s6);
        s6: res_op(flag, cas(false, true)) => next(s7);
        s7: return => return;
    }

    entry: main;
}
