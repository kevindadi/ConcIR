{
  "program": "producer_consumer",
  "resources": [
    { "name": "mtx", "kind": "sync", "type": "Mutex", "mode": "Sync" },
    { "name": "cv", "kind": "sync", "type": "Condvar", "mode": "Sync" },
    { "name": "count", "kind": "var", "type": "Var", "base": "Int", "init": 0 }
  ],
  "protection": [{ "var": "count", "lock": "mtx" }],
  "functions": [
    {
      "name": "main",
      "kind": "normal",
      "body": [
        {
          "sid": "s1",
          "op": ["spawn", "producer"],
          "transfer": ["next", "s2"]
        },
        {
          "sid": "s2",
          "op": ["spawn", "consumer"],
          "transfer": ["next", "s3"]
        },
        { "sid": "s3", "op": ["join", "producer"], "transfer": ["next", "s4"] },
        { "sid": "s4", "op": ["join", "consumer"], "transfer": ["next", "s5"] },
        { "sid": "s5", "op": "return", "transfer": "return" }
      ]
    },
    {
      "name": "producer",
      "kind": "closure",
      "body": [
        {
          "sid": "s1",
          "op": ["res_op", "mtx", "lock"],
          "transfer": ["next", "s2"]
        },
        {
          "sid": "s2",
          "op": ["res_op", "count", "write", "count + 1"],
          "transfer": ["next", "s3"]
        },
        {
          "sid": "s3",
          "op": ["res_op", "cv", "notify_all"],
          "transfer": ["next", "s4"]
        },
        {
          "sid": "s4",
          "op": ["res_op", "mtx", "drop"],
          "transfer": ["next", "s5"]
        },
        { "sid": "s5", "op": "return", "transfer": "return" }
      ]
    },
    {
      "name": "consumer",
      "kind": "closure",
      "body": [
        {
          "sid": "s1",
          "op": ["res_op", "mtx", "lock"],
          "transfer": ["next", "s2"]
        },
        {
          "sid": "s2",
          "op": ["res_op", "count", "read"],
          "transfer": ["branch", "count > 0", "s5", "s3"]
        },
        {
          "sid": "s3",
          "op": ["res_op", "cv", "wait", "mtx"],
          "transfer": ["next", "s4"]
        },
        { "sid": "s4", "op": "nop", "transfer": ["next", "s2"] },
        {
          "sid": "s5",
          "op": ["res_op", "count", "write", "count - 1"],
          "transfer": ["next", "s6"]
        },
        {
          "sid": "s6",
          "op": ["res_op", "mtx", "drop"],
          "transfer": ["next", "s7"]
        },
        { "sid": "s7", "op": "return", "transfer": "return" }
      ]
    }
  ],
  "fn_summaries": [],
  "entry": "main"
}
