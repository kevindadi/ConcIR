{
  "program": "producer_consumer",
  "version": "3.5.0",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "mtx",
          "cv",
          "count"
        ],
        "functions": [
          "main",
          "producer",
          "consumer"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "mtx",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "count",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "count",
          "lock": "mtx"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": ["producer", "consumer"]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "producer",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "count",
              "expr": "count + 1"
            },
            {
              "sid": "s3",
              "kind": "condvar_notify_all",
              "condvar": "cv"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "consumer",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "count"
            },
            {
              "sid": "s3",
              "kind": "branch",
              "cond": "count > 0",
              "then": "s7",
              "else": "s4"
            },
            {
              "sid": "s4",
              "kind": "condvar_wait",
              "condvar": "cv",
              "lock": "mtx"
            },
            {
              "sid": "s5",
              "kind": "nop"
            },
            {
              "sid": "s6",
              "kind": "goto",
              "target": "s2"
            },
            {
              "sid": "s7",
              "kind": "write_shared",
              "resource": "count",
              "expr": "count - 1"
            },
            {
              "sid": "s8",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ],
  "entry": "main::main"
}
