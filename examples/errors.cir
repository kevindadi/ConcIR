# CIR v0.2 — intentional errors for validator testing
program error_example {
    resources {
        sync mtx : Mutex(Sync);
        sync mtx : Mutex(Async);
        var counter : Var<Int> = 0;
        var unprotected_var : Var<Int> = 0;
        var flag : Atomic<Bool> = false;
        sync sem : Semaphore(Sync, 3);
    }

    protection {
        counter -> mtx;
        flag -> sem;
    }

    fn normal main {
        s0: spawn(worker) => next(s1);
        s1: spawn(missing_fn) => next(s2);
        s2: res_op(nonexistent, lock) => next(s3);
        s3: join(worker) => next(s4);
        s4: await(worker) => next(s5);
        s5: return => return;
    }

    fn normal worker {
        s0: res_op(counter, read) => next(s1);
        s1: res_op(counter, write(3.14)) => next(s2);
        s2: res_op(sem, lock) => next(s3);
        s3: res_op(flag, lock) => next(s4);
        s4: res_op(mtx, lock) => next(s5);
        s5: return => return;
    }

    fn async async_worker {
        s0: res_op(mtx, lock) => next(s1);
        s1: spawn_async(helper) => next(s2);
        s2: await(helper) => next(s3);
        s3: return => return;
    }

    fn_summary helper {
        reads: [counter, ghost_resource];
        writes: [];
        callees: [];
        has_concurrency: false;
    }

    entry: main;
}
