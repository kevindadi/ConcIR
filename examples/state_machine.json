{
  "program": "state_machine",
  "version": "3.1.0",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": ["mtx", "cv", "state"],
        "functions": ["main", "controller", "worker"]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "mtx",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "state",
          "kind": "var",
          "type": "Var",
          "base": {
            "Enum": ["Init", "Running", "Paused", "Stopped"]
          },
          "init": "Init"
        }
      ],
      "protection": [
        {
          "var": "state",
          "lock": "mtx"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "statements": [
                {
                  "kind": "spawn",
                  "func": "controller",
                  "handle": "h_controller"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s2"
              }
            },
            {
              "sid": "s2",
              "statements": [
                {
                  "kind": "spawn",
                  "func": "worker",
                  "handle": "h_worker"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s3"
              }
            },
            {
              "sid": "s3",
              "statements": [
                {
                  "kind": "join",
                  "handle": "h_controller"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s4"
              }
            },
            {
              "sid": "s4",
              "statements": [
                {
                  "kind": "join",
                  "handle": "h_worker"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s5"
              }
            },
            {
              "sid": "s5",
              "terminator": {
                "kind": "return"
              }
            }
          ]
        },
        {
          "name": "controller",
          "kind": "closure",
          "body": [
            {
              "sid": "s10",
              "statements": [
                {
                  "kind": "mutex_lock",
                  "resource": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s11"
              }
            },
            {
              "sid": "s11",
              "statements": [
                {
                  "kind": "write_shared",
                  "resource": "state",
                  "expr": "Running"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s12"
              }
            },
            {
              "sid": "s12",
              "statements": [
                {
                  "kind": "condvar_notify_all",
                  "condvar": "cv"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s13"
              }
            },
            {
              "sid": "s13",
              "statements": [
                {
                  "kind": "mutex_unlock",
                  "resource": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s14"
              }
            },
            {
              "sid": "s14",
              "terminator": {
                "kind": "return"
              }
            }
          ]
        },
        {
          "name": "worker",
          "kind": "closure",
          "body": [
            {
              "sid": "s20",
              "statements": [
                {
                  "kind": "mutex_lock",
                  "resource": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s21"
              }
            },
            {
              "sid": "s21",
              "statements": [
                {
                  "kind": "read_shared",
                  "resource": "state"
                }
              ],
              "terminator": {
                "kind": "switch",
                "var": "state",
                "cases": {
                  "Init": "s22",
                  "Running": "s23",
                  "Paused": "s24",
                  "Stopped": "s25"
                },
                "default": "s22"
              }
            },
            {
              "sid": "s22",
              "statements": [
                {
                  "kind": "condvar_wait",
                  "condvar": "cv",
                  "lock": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s21"
              }
            },
            {
              "sid": "s23",
              "statements": [
                {
                  "kind": "mutex_unlock",
                  "resource": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s26"
              }
            },
            {
              "sid": "s24",
              "statements": [
                {
                  "kind": "condvar_wait",
                  "condvar": "cv",
                  "lock": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s21"
              }
            },
            {
              "sid": "s25",
              "statements": [
                {
                  "kind": "mutex_unlock",
                  "resource": "mtx"
                }
              ],
              "terminator": {
                "kind": "goto",
                "target": "s26"
              }
            },
            {
              "sid": "s26",
              "terminator": {
                "kind": "return"
              }
            }
          ]
        }
      ]
    }
  ],
  "entry": "main::main"
}
