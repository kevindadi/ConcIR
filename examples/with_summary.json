{
  "program": "with_summary",
  "version": "3.4.0",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "mtx",
          "counter",
          "threshold"
        ],
        "functions": [
          "main",
          "worker",
          "validate",
          "helper_compare"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "mtx",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "counter",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        },
        {
          "name": "threshold",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 100
        }
      ],
      "protection": [
        {
          "var": "counter",
          "lock": "mtx"
        },
        {
          "var": "threshold",
          "lock": "mtx"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": ["worker"]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "worker",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "validate",
              "args": []
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "counter",
              "expr": "counter + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "validate",
          "kind": "normal",
          "body": [],
          "effects": {
            "reads": [
              "counter",
              "threshold"
            ],
            "writes": []
          }
        },
        {
          "name": "helper_compare",
          "kind": "normal",
          "body": [],
          "effects": {
            "reads": [
              "threshold"
            ],
            "writes": []
          }
        }
      ]
    }
  ],
  "entry": "main::main"
}
