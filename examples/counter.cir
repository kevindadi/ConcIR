# CIR v0.2 — valid counter example
program counter_example {
    resources {
        sync mtx : Mutex(Sync);
        var counter : Var<Int> = 0;
        sync ch : Channel(Async, Int);
        var flag : Atomic<Bool> = false;
    }

    protection {
        counter -> mtx;
    }

    fn normal main {
        s0: spawn(worker) => next(s1);
        s1: spawn(worker2) => next(s2);
        s2: join(worker) => next(s3);
        s3: join(worker2) => next(s4);
        s4: return => return;
    }

    fn normal worker {
        s0: res_op(mtx, lock) => next(s1);
        s1: res_op(counter, read) => next(s2);
        s2: res_op(counter, write(counter + 1)) => next(s3);
        s3: res_op(mtx, drop) => next(s4);
        s4: res_op(ch, send(42)) => next(s5);
        s5: return => return;
    }

    fn async worker2 {
        s0: res_op(flag, store(true)) => next(s1);
        s1: res_op(ch, recv) => next(s2);
        s2: return => return;
    }

    entry: main;
}
